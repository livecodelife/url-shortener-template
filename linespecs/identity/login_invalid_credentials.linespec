TEST Identity - login with wrong password returns 401

VARS
  EMAIL: string length=20 charset=alphanumeric
  PASSWORD: enum values=testpassword123
  USER_ID: string length=32 charset=alphanumeric

RECEIVE HTTP:POST /auth/login
WITH {{payloads/login_request.json}}
HEADERS
  Content-Type: application/json

EXPECT READ:POSTGRESQL
ACCESSING_TABLES [users]
VERIFY_OPERATION SELECT
VERIFY_WHERE
  email: ${EMAIL}
RETURNS {{payloads/wrong_password_row.yaml}}

EXPECT_NOT WRITE:POSTGRESQL tokens

RESPOND HTTP:401
