TEST Analytics - owner receives 200 with total clicks, 24h count, and recent clicks

VARS
  AUTH_TOKEN: string length=32 charset=alphanumeric
  USER_ID: string length=16 charset=alphanumeric
  SLUG: string length=8 charset=alphanumeric
  DESTINATION: string length=32 charset=alphanumeric

RECEIVE HTTP:GET /links/${SLUG}/analytics
HEADERS
  Authorization: Bearer ${AUTH_TOKEN}

EXPECT HTTP:GET http://identity-service.local/validate
HEADERS
  Authorization: Bearer ${AUTH_TOKEN}
RETURNS {{payloads/identity_valid.json}}

EXPECT READ:POSTGRESQL
ACCESSING_TABLES [links]
VERIFY_OPERATION SELECT
VERIFY_WHERE
  slug: ${SLUG}
RETURNS {{payloads/link_row.yaml}}

EXPECT READ:POSTGRESQL CALL 1
ACCESSING_TABLES [clicks]
VERIFY_WHERE_COLUMNS [slug]
RETURNS {{payloads/count_three.yaml}}

EXPECT READ:POSTGRESQL CALL 2
ACCESSING_TABLES [clicks]
VERIFY_WHERE_COLUMNS [slug, clicked_at]
RETURNS {{payloads/count_two.yaml}}

EXPECT READ:POSTGRESQL CALL 3
ACCESSING_TABLES [clicks]
VERIFY_OPERATION SELECT
RETURNS {{payloads/recent_clicks.yaml}}

RESPOND HTTP:200
WITH {{payloads/analytics_response.json}}
NOISE
  body.recent_clicks[*].clicked_at
