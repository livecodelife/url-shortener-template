TEST Delete link - owner can delete link and all clicks in a single transaction

VARS
  AUTH_TOKEN: string length=32 charset=alphanumeric
  USER_ID: string length=16 charset=alphanumeric
  SLUG: string length=8 charset=alphanumeric
  DESTINATION: string length=32 charset=alphanumeric

RECEIVE HTTP:DELETE /links/${SLUG}
HEADERS
  Authorization: Bearer ${AUTH_TOKEN}

EXPECT HTTP:GET http://identity-service.local/validate
HEADERS
  Authorization: Bearer ${AUTH_TOKEN}
RETURNS {{payloads/identity_valid.json}}

EXPECT READ:POSTGRESQL
ACCESSING_TABLES [links]
VERIFY_OPERATION SELECT
VERIFY_WHERE
  slug: ${SLUG}
RETURNS {{payloads/link_row.yaml}}

EXPECT WRITE:POSTGRESQL
ACCESSING_TABLES [clicks]
VERIFY_OPERATION DELETE
WITH {{payloads/write_result.yaml}}

EXPECT WRITE:POSTGRESQL
ACCESSING_TABLES [links]
VERIFY_OPERATION DELETE
WITH {{payloads/write_result.yaml}}

RESPOND HTTP:204
